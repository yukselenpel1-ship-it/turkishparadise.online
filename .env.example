# Environment Variables Template for Turkish Paradise V2 Architecture

# Database configuration
# Development supports sqlite file DB, Production requires PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# Server Environment & Port
NODE_ENV="development"
PORT=3001

# Allowed Origin for CORS & Socket.IO Security
CORS_ORIGIN="http://localhost:5173"

# Authentication Secrets
JWT_SECRET="change_this_to_a_high_entropy_secret_in_production"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
