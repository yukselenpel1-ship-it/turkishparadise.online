# ==========================================
# TURKISH PARADISE - GOOGLE OAUTH 2.0 AYARLARI
# ==========================================

# 1. Google Cloud Console'dan (console.cloud.google.com) oluşturduğunuz OAuth 2.0 Web Client ID:
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 2. Authorized Redirect URI (Google Cloud Console'a eklenecek tam alan adı):
# Canlı alan adınız: https://turkishparadise.online
# Vercel adresi: https://turkishparadise-online.vercel.app
# Yerel test adresi: http://localhost:5173
VITE_GOOGLE_REDIRECT_URI=https://turkishparadise.online

# ==========================================
# FIREBASE AYARLARI (İsteğe bağlı)
# ==========================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=turkishparadise-game.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://turkishparadise-game-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=turkishparadise-game
VITE_FIREBASE_STORAGE_BUCKET=turkishparadise-game.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
